# ── Local development ───────────────────────────────────────────────
# Origin the Vite dev server proxies /api to. Only used by `npm run dev`.
VITE_BACKEND_ORIGIN=http://localhost:4000

# ── Production build (Vercel) ───────────────────────────────────────
# Deployed backend origin — NO trailing slash, NO /api/v1 suffix.
# Leave unset for local dev (the proxy above handles it).
# VITE_API_BASE_URL=https://renovia-api.onrender.com
