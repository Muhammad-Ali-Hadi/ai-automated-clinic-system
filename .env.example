NODE_ENV=development

PORT=4000

DATABASE_URL="postgresql://postgres.project-ref:change-me@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project-ref:change-me@aws-0-region.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="replace-with-a-32-character-minimum-secret"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins. Set an explicit public origin in production.
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info
# SMTP email (required in production; password/verification tokens are never logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Renovia Hospital OS <no-reply@renovia.local>

# Object storage (S3-compatible, optional)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Worker reliability controls
JOB_POLL_INTERVAL_MS=1000
JOB_LOCK_TIMEOUT_SECONDS=300
JOB_MAX_BACKOFF_SECONDS=300

# Set only when deployed behind a trusted reverse proxy; 0 is safe for direct Node hosting.
TRUST_PROXY_HOPS=0
