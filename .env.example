NODE_ENV=development

PORT=4000

DATABASE_URL="postgresql://postgres.project-ref:change-me@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project-ref:change-me@aws-0-region.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="replace-with-a-32-character-minimum-secret"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins. Set an explicit public origin in production.
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info
# SMTP email (required in production; password/verification tokens are never logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Renovia Hospital OS <no-reply@renovia.local>

# Object storage (S3-compatible, optional)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Worker reliability controls
JOB_POLL_INTERVAL_MS=1000
JOB_LOCK_TIMEOUT_SECONDS=300
JOB_MAX_BACKOFF_SECONDS=300

# Set only when deployed behind a trusted reverse proxy; 0 is safe for direct Node hosting.
TRUST_PROXY_HOPS=0

# Global API rate limit. Disabled automatically when NODE_ENV=development.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ─── Rizocare AI Platform ───────────────────────────────────────────────────────────────────

# Groq (chat completions + Whisper speech-to-text — free tier)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_replace-me
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Google Gemini (embeddings — text-embedding-004, 768 dims, free tier)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-me
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (optional — keep commented out; uncomment for paid upgrade in future)
# OPENAI_API_KEY=sk-replace-me
# OPENAI_DEFAULT_MODEL=gpt-4.1-mini

# Future providers (optional)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Qdrant vector database
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_DEFAULT_COLLECTION=rizocare_knowledge

# Redis (conversation memory + embedding cache)
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=86400

# MongoDB AI logs (optional)
# MONGO_URL=mongodb://localhost:27017
MONGO_AI_DB=rizocare_ai

# AI tuning
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_MAX_CONTEXT_MESSAGES=20
AI_SUMMARIZE_AFTER_MESSAGES=15
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300

# RAG
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200
