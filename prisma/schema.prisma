generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
  PHARMACIST
  LABORATORY_TECHNICIAN
  ACCOUNTANT
  PATIENT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Hospital {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String                 @unique
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  patients              Patient[]
  jobs                  BackgroundJob[]
  departments           Department[]
  doctors               DoctorProfile[]
  appointments          Appointment[]
  consultations         Consultation[]
  prescriptions         Prescription[]
  dispenseRecords       DispenseRecord[]
  medicineBatches       MedicineBatch[]
  medicalRecords        MedicalRecord[]
  labTests              LabTest[]
  labResultHistories    LabResultHistory[]
  medicines             Medicine[]
  invoices              Invoice[]
  employees             Employee[]
  notifications         Notification[]
  reminders             Reminder[]
  files                 FileObject[]
  auditLogs             AuditLog[]
  settings              HospitalSettings?
  branches              Branch[]
  emergencyContacts     EmergencyContact[]
  insurances            PatientInsurance[]
  allergies             PatientAllergy[]
  chronicDiseases       ChronicDisease[]
  vitals                PatientVital[]
  patientNotes          PatientNote[]
  dischargeSummaries    DischargeSummary[]
  availabilities        DoctorAvailability[]
  queueEntries          QueueEntry[]
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]
  purchaseOrders        PurchaseOrder[]
  invoiceItems          InvoiceItem[]
  payments              Payment[]
  refunds               Refund[]
  inventoryItems        InventoryItem[]
  receipts              Receipt[]
  payrollIntegrations   PayrollIntegration[]
  notificationTemplates NotificationTemplate[]
  insuranceClaims       InsuranceClaim[]
  suppliers             Supplier[]
  shifts                Shift[]
  performanceNotes      PerformanceNote[]
}

model User {
  id                       String             @id @default(uuid()) @db.Uuid
  hospitalId               String?            @db.Uuid
  email                    String             @unique
  passwordHash             String
  firstName                String
  lastName                 String
  role                     Role
  isActive                 Boolean            @default(true)
  emailVerifiedAt          DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  hospital                 Hospital?          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  sessions                 Session[]
  loginEvents              LoginEvent[]
  doctorProfile            DoctorProfile?
  recordedMedicalRecords   MedicalRecord[]    @relation("RecordedMedicalRecords")
  requestedLabTests        LabTest[]          @relation("RequestedLabTests")
  recordedLabResults       LabResultHistory[] @relation("RecordedLabResults")
  employees                Employee[]
  dispenseRecords          DispenseRecord[]
  issuedReceipts           Receipt[]
  notifications            Notification[]
  reminders                Reminder[]
  uploadedFiles            FileObject[]       @relation("UploadedFiles")
  auditLogs                AuditLog[]
  recordedVitals           PatientVital[]
  authoredPatientNotes     PatientNote[]
  dischargeSummaries       DischargeSummary[]
  shifts                   Shift[]
  approvedInsuranceClaims  InsuranceClaim[]   @relation("ClaimApprover")
  recordedPerformanceNotes PerformanceNote[]
  userShifts               UserShift[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  processedRefunds         Refund[]                @relation("ProcessedRefunds")

  @@index([hospitalId, role])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  email     String
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

model Patient {
  id                  String             @id @default(uuid()) @db.Uuid
  hospitalId          String             @db.Uuid
  medicalRecordNumber String
  firstName           String
  lastName            String
  dateOfBirth         DateTime           @db.Date
  phone               String?
  email               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  status              PatientStatus      @default(ACTIVE)
  archivedAt          DateTime?
  hospital            Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointments        Appointment[]
  consultations       Consultation[]
  prescriptions       Prescription[]
  dispenseRecords     DispenseRecord[]
  medicalRecords      MedicalRecord[]
  labTests            LabTest[]
  invoices            Invoice[]
  files               FileObject[]
  emergencyContacts   EmergencyContact[]
  insurances          PatientInsurance[]
  allergies           PatientAllergy[]
  chronicDiseases     ChronicDisease[]
  vitals              PatientVital[]
  notes               PatientNote[]
  dischargeSummaries  DischargeSummary[]
  insuranceClaims     InsuranceClaim[]

  @@unique([hospitalId, medicalRecordNumber])
  @@index([hospitalId, lastName, firstName])
  @@index([hospitalId, deletedAt, createdAt])
}

model BackgroundJob {
  id            String    @id @default(uuid()) @db.Uuid
  hospitalId    String?   @db.Uuid
  type          String
  payload       Json
  status        JobStatus @default(PENDING)
  runAt         DateTime  @default(now())
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lockedAt      DateTime?
  lockedBy      String?
  completedAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  hospital      Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
  @@index([hospitalId, status, runAt])
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LabRequestStatus {
  REQUESTED
  COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

model Department {
  id           String        @id @default(uuid()) @db.Uuid
  hospitalId   String        @db.Uuid
  name         String
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  employees    Employee[]

  @@unique([hospitalId, name])
  @@index([hospitalId, isActive])
}

model DoctorProfile {
  id              String               @id @default(uuid()) @db.Uuid
  hospitalId      String               @db.Uuid
  userId          String               @unique @db.Uuid
  specialization  String
  licenseNumber   String
  consultationFee Decimal?             @db.Decimal(12, 2)
  signatureUrl    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hospital        Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  consultations   Consultation[]
  availabilities  DoctorAvailability[]

  @@unique([hospitalId, licenseNumber])
  @@index([hospitalId, specialization])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  hospitalId      String            @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String            @db.Uuid
  departmentId    String?           @db.Uuid
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(BOOKED)
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  department      Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  consultation    Consultation?
  queueEntry      QueueEntry?

  @@index([hospitalId, scheduledAt, status])
  @@index([hospitalId, patientId, scheduledAt])
  @@index([hospitalId, doctorId, scheduledAt])
}

model Consultation {
  id            String         @id @default(uuid()) @db.Uuid
  hospitalId    String         @db.Uuid
  patientId     String         @db.Uuid
  doctorId      String         @db.Uuid
  appointmentId String?        @unique @db.Uuid
  clinicalNotes String
  diagnosis     String?
  treatmentPlan String?
  followUpAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([hospitalId, patientId, createdAt])
}

model Prescription {
  id              String           @id @default(uuid()) @db.Uuid
  hospitalId      String           @db.Uuid
  patientId       String           @db.Uuid
  consultationId  String?          @db.Uuid
  prescribedById  String           @db.Uuid
  medicineName    String
  dosage          String
  frequency       String
  durationDays    Int
  instructions    String?
  createdAt       DateTime         @default(now())
  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation    Consultation?    @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  dispenseRecords DispenseRecord[]
  insuranceClaims InsuranceClaim[]
  inventoryItems  InventoryItem[]

  @@index([hospitalId, patientId, createdAt])
}

model MedicalRecord {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalId   String   @db.Uuid
  patientId    String   @db.Uuid
  recordType   String
  title        String
  content      String
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy   User     @relation("RecordedMedicalRecords", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, patientId, createdAt])
}

model LabTest {
  id              String           @id @default(uuid()) @db.Uuid
  hospitalId      String           @db.Uuid
  patientId       String           @db.Uuid
  requestedById   String           @db.Uuid
  testName        String
  status          LabRequestStatus @default(REQUESTED)
  result          String?
  referenceRange  String?
  collectedAt     DateTime?
  approvedAt      DateTime?
  barcode         String?
  rejectionReason String?
  rejectedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  requestedBy     User             @relation("RequestedLabTests", fields: [requestedById], references: [id], onDelete: Restrict)
  files           FileObject[]
  resultHistory   LabResultHistory[]

  @@unique([hospitalId, barcode])
  @@index([hospitalId, patientId, status, createdAt])
}

model LabResultHistory {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String   @db.Uuid
  labTestId     String   @db.Uuid
  recordedById  String   @db.Uuid
  result        String
  referenceRange String?
  recordedAt    DateTime @default(now())
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  labTest       LabTest  @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  recordedBy    User     @relation("RecordedLabResults", fields: [recordedById], references: [id], onDelete: Restrict)
  @@index([hospitalId, labTestId, recordedAt])
}

model DischargeSummary {
  id                   String   @id @default(uuid()) @db.Uuid
  hospitalId           String   @db.Uuid
  patientId            String   @db.Uuid
  dischargedById       String   @db.Uuid
  diagnosis            String?
  summary              String
  medications          String?
  followUpInstructions String?
  dischargedAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hospital             Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dischargedBy         User     @relation(fields: [dischargedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, patientId, dischargedAt])
}

model Medicine {
  id              String           @id @default(uuid()) @db.Uuid
  hospitalId      String           @db.Uuid
  name            String
  category        String?
  sku             String
  quantity        Int              @default(0)
  reorderLevel    Int              @default(10)
  unitPrice       Decimal          @db.Decimal(12, 2)
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  purchaseOrders  PurchaseOrder[]
  batches         MedicineBatch[]
  dispenseRecords DispenseRecord[]

  @@unique([hospitalId, sku])
  @@index([hospitalId, name])
  @@index([hospitalId, expiresAt])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  hospitalId    String        @db.Uuid
  patientId     String        @db.Uuid
  invoiceNumber String
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  hospital      Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  payments      Payment[]
  receipts      Receipt[]
  insuranceClaims InsuranceClaim[]
  refunds       Refund[]

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId, status, createdAt])
}

model Employee {
  id            String         @id @default(uuid()) @db.Uuid
  hospitalId    String         @db.Uuid
  userId        String?        @db.Uuid
  departmentId  String?        @db.Uuid
  designation   String
  joinedAt      DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendances   Attendance[]
  leaveRequests LeaveRequest[]

  @@index([hospitalId, designation])
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  hospitalId String?             @db.Uuid
  userId     String              @db.Uuid
  channel    NotificationChannel
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime            @default(now())
  hospital   Hospital?           @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
}

model FileObject {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalId   String   @db.Uuid
  patientId    String?  @db.Uuid
  uploadedById String   @db.Uuid
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    BigInt
  createdAt    DateTime @default(now())
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  labTestId    String?  @db.Uuid
  category     String?
  labTest      LabTest? @relation(fields: [labTestId], references: [id], onDelete: SetNull)
  uploadedBy   User     @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([hospitalId, storageKey])
  @@index([hospitalId, patientId, createdAt])
  @@index([hospitalId, labTestId])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  hospitalId  String?   @db.Uuid
  actorUserId String?   @db.Uuid
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
}

enum PatientStatus {
  ACTIVE
  ARCHIVED
  MERGED
  DECEASED
}

model HospitalSettings {
  id                 String    @id @default(uuid()) @db.Uuid
  hospitalId         String    @unique @db.Uuid
  preferences        Json?
  configuration      Json?
  subscriptionPlan   String?
  subscriptionEndsAt DateTime?
  logoKey            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  hospital           Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model Branch {
  id           String        @id @default(uuid()) @db.Uuid
  hospitalId   String        @db.Uuid
  name         String
  address      String?
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  workingHours WorkingHour[]

  @@unique([hospitalId, name])
  @@index([hospitalId, isActive])
}

model WorkingHour {
  id       String  @id @default(uuid()) @db.Uuid
  branchId String  @db.Uuid
  weekday  Int
  opensAt  String
  closesAt String
  isClosed Boolean @default(false)
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, weekday])
}

model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalId   String   @db.Uuid
  patientId    String   @db.Uuid
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([hospitalId, patientId])
}

model PatientInsurance {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @db.Uuid
  patientId    String    @db.Uuid
  provider     String
  policyNumber String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hospital     Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, provider, policyNumber])
  @@index([hospitalId, patientId])
}

model PatientAllergy {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  patientId  String   @db.Uuid
  substance  String
  severity   String?
  reaction   String?
  createdAt  DateTime @default(now())
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([hospitalId, patientId])
}

model ChronicDisease {
  id          String    @id @default(uuid()) @db.Uuid
  hospitalId  String    @db.Uuid
  patientId   String    @db.Uuid
  name        String
  diagnosedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([hospitalId, patientId])
}

model PatientVital {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalId   String   @db.Uuid
  patientId    String   @db.Uuid
  recordedById String   @db.Uuid
  temperature  Decimal? @db.Decimal(5, 2)
  systolicBp   Int?
  diastolicBp  Int?
  pulse        Int?
  weightKg     Decimal? @db.Decimal(6, 2)
  recordedAt   DateTime @default(now())
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, patientId, recordedAt])
}

model PatientNote {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  patientId  String   @db.Uuid
  authorId   String   @db.Uuid
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([hospitalId, patientId, createdAt])
}

model DoctorAvailability {
  id          String        @id @default(uuid()) @db.Uuid
  hospitalId  String        @db.Uuid
  doctorId    String        @db.Uuid
  weekday     Int
  startsAt    String
  endsAt      String
  isAvailable Boolean       @default(true)
  hospital    Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, weekday, startsAt])
  @@index([hospitalId, doctorId, weekday])
}

model QueueEntry {
  id            String      @id @default(uuid()) @db.Uuid
  hospitalId    String      @db.Uuid
  appointmentId String      @unique @db.Uuid
  queueNumber   Int
  status        String      @default("WAITING")
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  createdAt     DateTime    @default(now())
  hospital      Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, queueNumber])
  @@index([hospitalId, status, createdAt])
}

model Attendance {
  id         String    @id @default(uuid()) @db.Uuid
  hospitalId String    @db.Uuid
  employeeId String    @db.Uuid
  date       String
  checkIn    DateTime
  checkOut   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([hospitalId, employeeId, date])
}

model LeaveRequest {
  id         String    @id @default(uuid()) @db.Uuid
  hospitalId String    @db.Uuid
  employeeId String    @db.Uuid
  type       String
  startDate  String
  endDate    String
  reason     String
  status     String    @default("PENDING")
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([hospitalId, employeeId, status])
}

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @db.Uuid
  medicineId   String    @db.Uuid
  supplierName String
  quantity     Int
  unitCost     Decimal   @db.Decimal(12, 2)
  status       String    @default("PENDING")
  orderDate    DateTime  @default(now())
  receivedAt   DateTime?
  supplierId   String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hospital Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  medicine Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([hospitalId, medicineId, status])
}

model InvoiceItem {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  invoiceId  String   @db.Uuid
  name       String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([hospitalId, invoiceId])
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  hospitalId     String   @db.Uuid
  invoiceId      String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  method         String
  status         String   @default("COMPLETED")
  idempotencyKey String?
  createdAt      DateTime @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId, invoiceId])
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String   @db.Uuid
  invoiceId   String   @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("COMPLETED")
  refundedById String  @db.Uuid
  createdAt   DateTime @default(now())
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refundedBy  User     @relation("ProcessedRefunds", fields: [refundedById], references: [id], onDelete: Restrict)
  @@index([hospitalId, invoiceId, createdAt])
}

enum InventoryItemType {
  EQUIPMENT
  CONSUMABLE
}

enum InventoryItemStatus {
  ACTIVE
  RETIRED
}

enum ReminderType {
  APPOINTMENT
  PAYMENT
  PRESCRIPTION
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum NotificationTemplateChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationTemplateStatus {
  ACTIVE
  INACTIVE
}

enum InsuranceClaimStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model MedicineBatch {
  id          String    @id @default(uuid()) @db.Uuid
  hospitalId  String    @db.Uuid
  medicineId  String    @db.Uuid
  batchNumber String
  quantity    Int       @default(0)
  expiresAt   DateTime?
  receivedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  medicine    Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, medicineId, batchNumber])
  @@index([hospitalId, expiresAt])
}

model DispenseRecord {
  id             String        @id @default(uuid()) @db.Uuid
  hospitalId     String        @db.Uuid
  patientId      String        @db.Uuid
  medicineId     String        @db.Uuid
  prescriptionId String?       @db.Uuid
  dispensedById  String        @db.Uuid
  quantity       Int
  dispensedAt    DateTime      @default(now())
  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  medicine       Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  dispensedBy    User          @relation(fields: [dispensedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, patientId, dispensedAt])
  @@index([hospitalId, medicineId, dispensedAt])
}

model InventoryItem {
  id             String              @id @default(uuid()) @db.Uuid
  hospitalId     String              @db.Uuid
  name           String
  type           InventoryItemType
  category       String?
  quantity       Int                 @default(0)
  reorderLevel   Int                 @default(0)
  unitCost       Decimal?            @db.Decimal(12, 2)
  location       String?
  status         InventoryItemStatus @default(ACTIVE)
  supplierName   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  hospital       Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  prescription   Prescription?       @relation(fields: [prescriptionId], references: [id])
  prescriptionId String?             @db.Uuid

  @@index([hospitalId, type, status])
  @@index([hospitalId, quantity])
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String   @db.Uuid
  invoiceId     String   @db.Uuid
  receiptNumber String
  amount        Decimal  @db.Decimal(12, 2)
  issuedById    String   @db.Uuid
  issuedAt      DateTime @default(now())
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  issuedBy      User     @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  @@unique([hospitalId, receiptNumber])
  @@unique([hospitalId, invoiceId])
  @@index([hospitalId, issuedAt])
}

model PayrollIntegration {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String   @db.Uuid
  providerName  String
  status        String   @default("CONFIGURED")
  configuration Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, providerName])
}

model Reminder {
  id              String         @id @default(uuid()) @db.Uuid
  hospitalId      String         @db.Uuid
  userId          String?        @db.Uuid
  type            ReminderType
  status          ReminderStatus @default(SCHEDULED)
  subject         String
  body            String
  runAt           DateTime
  backgroundJobId String?        @unique @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hospitalId, status, runAt])
}

model NotificationTemplate {
  id         String                      @id @default(uuid()) @db.Uuid
  hospitalId String                      @db.Uuid
  name       String
  subject    String?
  body       String
  channel    NotificationTemplateChannel
  status     NotificationTemplateStatus  @default(ACTIVE)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  hospital   Hospital                    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, name])
  @@index([hospitalId, channel, status])
}

model InsuranceClaim {
  id              String               @id @default(uuid()) @db.Uuid
  hospitalId      String               @db.Uuid
  patientId       String               @db.Uuid
  invoiceId       String?              @db.Uuid
  claimNumber     String
  providerName    String
  amount          Decimal              @db.Decimal(12, 2)
  status          InsuranceClaimStatus @default(PENDING)
  submittedAt     DateTime             @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvedById    String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hospital        Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  approvedBy      User?                @relation("ClaimApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  prescription    Prescription?        @relation(fields: [prescriptionId], references: [id])
  prescriptionId  String?              @db.Uuid

  @@unique([hospitalId, claimNumber])
  @@index([hospitalId, patientId, status, submittedAt])
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  hospitalId     String          @db.Uuid
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([hospitalId, name])
  @@index([hospitalId, isActive])
}

model Shift {
  id          String      @id @default(uuid()) @db.Uuid
  hospitalId  String      @db.Uuid
  name        String
  startsAt    String
  endsAt      String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  userShifts  UserShift[]
  user        User?       @relation(fields: [userId], references: [id])
  userId      String?     @db.Uuid

  @@unique([hospitalId, name])
  @@index([hospitalId, isActive])
}

model UserShift {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  shiftId    String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, shiftId])
  @@index([userId])
}

model PerformanceNote {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalId   String   @db.Uuid
  employeeId   String   @db.Uuid
  note         String
  rating       Int?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, createdAt])
}
